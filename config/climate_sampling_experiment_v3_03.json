        "hash_modulus": 500,
        "inverse_inclusion_weight": 500.0
      }
    ],
    "sampling_seed": "plexa-baseline-v1",
    "hash_expression": "md5_number_lower(street_segment_id || '|' || epoch(prediction_time_utc)::VARCHAR || 'plexa-baseline-v1')",
    "keep_rule": "hash_expression % stratum_hash_modulus = 0",
