# Preserve reproducible source hashes across Windows and Unix checkouts.
* text=auto eol=lf
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.csv text eol=lf
*.pkl -text
*.parquet -text
*.db -text
*.dump -text
*.pdf -text
*.png -text

# Preserve frozen evaluation files exactly as recorded in their manifests.
/outputs/mobility/baselines_v1/** -text !eol whitespace=cr-at-eol
/outputs/mobility/gradient_boosted_v1/** -text !eol whitespace=cr-at-eol
